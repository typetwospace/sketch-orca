+//
+// sketch-orca oracle patch 0005 (2026-11-06): the dump knob of the parity oracle, a build that never
+// ships. SKETCH_ORCA_ORACLE_DUMP=<folder>, an existing folder, makes the oracle write the state it
+// has at step boundaries, and only there, as SOP1 files (parity/SOP1.md in sketch-orca):
+// - after each PrintObject step (PrintObjectBaseWithState::set_done, PrintBase.hpp):
+//   object<i>-<step>-<n>.sop1, the object's layers, regions, surfaces, extrusions and support layers;
+// - after each Print step (PrintBaseWithState::set_done): print-<step>-<n>.sop1, the skirt, brims,
+//   tool ordering, wipe tower, statistics and conflict check;
+// - in the front end once the objects are placed: front-objects-<n>.sop1, the model;
+// - in the front end once the config is resolved, before each slice: front-config-<n>.sop1, the
+//   front end's config, the print's, and each object's and region's.
+// <i> is the object's index in the print, <step> the step's name in Print.hpp (posSlice,
+// psWipeTower, ...) and <n> counts the boundaries of that name from 1. Writing is serialised, so
+// objects whose steps run at the same time (the supports) write their own files whole. Unset,
+// nothing is written and nothing else changes.
+#ifndef slic3r_OracleDump_hpp_
+#define slic3r_OracleDump_hpp_
+
+#include <string>
+
+namespace Slic3r {
+
+class DynamicPrintConfig;
+class Model;
+class Print;
+class PrintBase;
+class PrintObjectBase;
+
+namespace Oracle {
+
+// Whether SKETCH_ORCA_ORACLE_DUMP is set to an existing folder.
+bool dump_enabled();
+// Why SKETCH_ORCA_ORACLE_DUMP is refused, or "" when it is not set or names an existing folder.
+std::string dump_knob_problem();
+
+// The step boundaries; each does nothing unless dump_enabled(). A Print or PrintObject of another
+// printer technology (SLA) is not dumped.
+void dump_print_step(const PrintBase &print, int step);
+void dump_object_step(const PrintObjectBase &object, int step);
+// The front end's two boundaries.
+void dump_front_objects(const Model &model);
+void dump_front_config(const Print &print, const DynamicPrintConfig &config);
+
+} // namespace Oracle
+} // namespace Slic3r
+
+#endif // slic3r_OracleDump_hpp_
