+//
+// sketch-orca oracle patch 0002 (2026-11-06): the seed knob (OracleSeed.hpp).
+#include "OracleSeed.hpp"
+
+#include <cstdlib>
+
+namespace Slic3r {
+namespace Oracle {
+
+namespace {
+
+// 1 set and valid (*out is the seed), 0 not set, -1 set to something that is not a seed.
+int read_seed(uint32_t *out)
+{
+    const char *text = std::getenv("SKETCH_ORCA_ORACLE_SEED");
+    if (text == nullptr)
+        return 0;
+    unsigned long long value  = 0;
+    int                digits = 0;
+    for (; *text != '\0'; ++text) {
+        if (*text < '0' || *text > '9' || ++digits > 10)
+            return -1;
+        value = value * 10 + unsigned(*text - '0');
+    }
+    if (digits == 0 || value > 4294967295ull)
+        return -1;
+    if (out != nullptr)
+        *out = uint32_t(value);
+    return 1;
+}
+
+} // namespace
+
+bool seed_set()
+{
+    return read_seed(nullptr) == 1;
+}
+
+uint32_t seed()
+{
+    uint32_t value = 0;
+    read_seed(&value);
+    return value;
+}
+
+std::string seed_knob_problem()
+{
+    if (read_seed(nullptr) >= 0)
+        return std::string();
+    return "SKETCH_ORCA_ORACLE_SEED must be a whole number from 0 to 4294967295, with nothing else in it";
+}
+
+} // namespace Oracle
+} // namespace Slic3r
