+//
+// sketch-orca oracle patch 0002 (2026-11-06): the seed knob of the parity oracle, a build that
+// never ships. SKETCH_ORCA_ORACLE_SEED, when set, is a whole number from 0 to 4294967295 that seeds
+// the two generators whose seeds come from entropy: fuzzy skin's thread_local mt19937
+// (Feature/FuzzySkin/FuzzySkin.cpp, in place of std::random_device) and the placeholder parser's
+// mt19937 (GCode.cpp, in place of the high-resolution clock). Each thread's fuzzy skin generator
+// gets the same seed. rand() keeps the C runtime's default seed of 1 on each thread, as in the
+// engine; nothing here calls srand. Unset, both generators are seeded as before.
+#ifndef slic3r_OracleSeed_hpp_
+#define slic3r_OracleSeed_hpp_
+
+#include <cstdint>
+#include <string>
+
+namespace Slic3r {
+namespace Oracle {
+
+// Whether SKETCH_ORCA_ORACLE_SEED is set to a valid seed.
+bool seed_set();
+// The seed; only when seed_set().
+uint32_t seed();
+// Why SKETCH_ORCA_ORACLE_SEED is refused, or "" when it is not set or valid.
+std::string seed_knob_problem();
+
+} // namespace Oracle
+} // namespace Slic3r
+
+#endif // slic3r_OracleSeed_hpp_
