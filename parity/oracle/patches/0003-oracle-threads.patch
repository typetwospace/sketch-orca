+// sketch-orca oracle patch 0003 (2026-11-06): the thread knob (OracleThreads.hpp).
+#include "OracleThreads.hpp"
+
+#include <cstdlib>
+
+namespace Slic3r {
+namespace Oracle {
+
+namespace {
+
+const unsigned THREADS_MAX = 256;
+
+// 1 set and valid (*out is P), 0 not set, -1 set to something that is not a P.
+int read_threads(unsigned *out)
+{
+    const char *text = std::getenv("SKETCH_ORCA_ORACLE_THREADS");
+    if (text == nullptr)
+        return 0;
+    unsigned value  = 0;
+    int      digits = 0;
+    for (; *text != '\0'; ++text) {
+        if (*text < '0' || *text > '9' || ++digits > 3)
+            return -1;
+        value = value * 10 + unsigned(*text - '0');
+    }
+    if (digits == 0 || value < 1 || value > THREADS_MAX)
+        return -1;
+    if (out != nullptr)
+        *out = value;
+    return 1;
+}
+
+} // namespace
+
+bool threads_set()
+{
+    return read_threads(nullptr) == 1;
+}
+
+unsigned threads()
+{
+    unsigned value = 0;
+    read_threads(&value);
+    return value;
+}
+
+std::string threads_knob_problem()
+{
+    if (read_threads(nullptr) >= 0)
+        return std::string();
+    return "SKETCH_ORCA_ORACLE_THREADS must be a whole number from 1 to 256, with nothing else in it";
+}
+
+} // namespace Oracle
+} // namespace Slic3r
