+// is the engine's at P, the same on every run. utils.cpp's disable_multi_threading is left as it is:
+// it builds a temporary global_control, which does nothing. With the knob set, Thread.cpp's
+// name_tbb_thread_pool_threads_set_locale returns at once: there are no worker threads to name, and
+// its barrier, which waits until max_concurrency() tasks run at the same time, would wait forever
+// on one thread. Unset, nothing changes.
+#ifndef slic3r_OracleThreads_hpp_
+#define slic3r_OracleThreads_hpp_
+
+#include <string>
+
+namespace Slic3r {
+namespace Oracle {
+
+// Whether SKETCH_ORCA_ORACLE_THREADS is set to a valid P.
+bool threads_set();
+// P; only when threads_set().
+unsigned threads();
+// Why SKETCH_ORCA_ORACLE_THREADS is refused, or "" when it is not set or valid.
+std::string threads_knob_problem();
+
+} // namespace Oracle
+} // namespace Slic3r
+
+#endif // slic3r_OracleThreads_hpp_
