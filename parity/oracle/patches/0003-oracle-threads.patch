-int main(int argc, char **argv)
+// sketch-orca oracle patch 0003 (2026-11-06): the front end's main, renamed; main below runs it, inside
+// the thread knob's arena when SKETCH_ORCA_ORACLE_THREADS is set.
+static int engine_main(int argc, char **argv)
 {
     // sketch-orca oracle patch 0001 (2026-11-06): SKETCH_ORCA_ORACLE_TIME, when set, must be a time.
     if (const std::string problem = Slic3r::Oracle::clock_knob_problem(); !problem.empty())
@@ -323,3 +330,22 @@ int main(int argc, char **argv)
     }
     return usage_error("unknown command " + command);
 }
+
+// sketch-orca oracle patch 0003 (2026-11-06): with SKETCH_ORCA_ORACLE_THREADS=P the whole run happens
+// inside a tbb::task_arena of concurrency P, so this_task_arena::max_concurrency() and the partitioners
+// see P, while a tbb::global_control(max_allowed_parallelism, 1), held until the run ends, leaves TBB no
+// worker thread: every task runs on this thread, in one order, the same on every run. All P slots are
+// reserved for application threads, so the arena asks TBB for no worker (asking for P - 1 under that
+// limit would make TBB print a warning to stderr on a machine without P hardware threads). Unset, main
+// is the front end's main as it was.
+int main(int argc, char **argv)
+{
+    if (const std::string problem = Slic3r::Oracle::threads_knob_problem(); !problem.empty())
+        return oracle_knob_error(problem);
+    if (!Slic3r::Oracle::threads_set())
+        return engine_main(argc, argv);
+    const unsigned      threads = Slic3r::Oracle::threads();
+    tbb::global_control one_thread(tbb::global_control::max_allowed_parallelism, 1);
+    tbb::task_arena     arena{static_cast<int>(threads), threads};
+    return arena.execute([&]() -> int { return engine_main(argc, argv); });
+}
