+//
+// sketch-orca oracle patch 0004 (2026-11-06): the FMA3 knob of the parity oracle, a build that never
+// ships. SKETCH_ORCA_ORACLE_FMA3=0 turns off the FMA3 code paths of the Universal CRT's x64 math
+// library (exp, log, pow, sin, cos and the rest) with _set_FMA3_enable(0), before any C++ static
+// initializer of the program runs (oracle_fma3.cpp), so every libm result is the one the CPU's SSE2
+// path gives, whatever the machine. SKETCH_ORCA_ORACLE_FMA3=1 leaves the CRT's own choice, as unset
+// does. Anything else is refused by main, before it does anything else.
+#ifndef sketch_orca_oracle_fma3_hpp_
+#define sketch_orca_oracle_fma3_hpp_
+
+#include <string>
+
+namespace sketch_orca {
+namespace oracle {
+
+// Why SKETCH_ORCA_ORACLE_FMA3 is refused, or "" when it is unset, 0 or 1.
+std::string fma3_knob_problem();
+
+} // namespace oracle
+} // namespace sketch_orca
+
+#endif // sketch_orca_oracle_fma3_hpp_
