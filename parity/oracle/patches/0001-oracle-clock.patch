+// Copyright (C) 2026 The sketch-orca authors (see AUTHORS)
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// This file is part of sketch-orca, a modified version of OrcaSlicer. sketch-orca is free software:
+// you can redistribute it and/or modify it under the terms of the GNU Affero General Public
+// License, version 3, as published by the Free Software Foundation. It is distributed in the hope
+// that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License
+// (LICENSE) for more details.
+//
+// sketch-orca oracle patch 0001 (2026-11-06): the clock knob of the parity oracle, a build that
+// never ships. With SKETCH_ORCA_ORACLE_TIME set (deps_src/miniz/sketch_orca_oracle_clock.h gives
+// its form), every clock read the oracle's outputs can reach gives that time, and its local time
+// is UTC: time() and localtime in PlaceholderParser::update_timestamp, Model::get_backup_path and
+// Lightning's srand, Utils::get_current_time_utc (Utils::local_timestamp, the G-code header) and
+// time2str's local time, the preset import time, and the zip entry times (miniz). Unset, every one
+// of them reads the real clock as before.
+#ifndef slic3r_OracleClock_hpp_
+#define slic3r_OracleClock_hpp_
+
+#include <ctime>
+#include <string>
+
+namespace Slic3r {
+namespace Oracle {
+
+// Whether SKETCH_ORCA_ORACLE_TIME pins the clock (it is set to a valid time).
+bool clock_pinned();
+// The pinned time; only when clock_pinned().
+std::time_t pinned_time();
+// The local time of `t` as the oracle sees it: UTC when the clock is pinned, else the machine's.
+// Fills `out` and returns it, or nullptr when `t` cannot be converted.
+std::tm *oracle_localtime(const std::time_t &t, std::tm &out);
+// Why SKETCH_ORCA_ORACLE_TIME is refused, or "" when it is not set or valid.
+std::string clock_knob_problem();
+
+} // namespace Oracle
+} // namespace Slic3r
+
+#endif // slic3r_OracleClock_hpp_
