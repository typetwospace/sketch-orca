+// Copyright (C) 2026 The sketch-orca authors (see AUTHORS)
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// This file is part of sketch-orca, a modified version of OrcaSlicer. sketch-orca is free software:
+// you can redistribute it and/or modify it under the terms of the GNU Affero General Public
+// License, version 3, as published by the Free Software Foundation. It is distributed in the hope
+// that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License
+// (LICENSE) for more details.
+//
+// sketch-orca oracle patch 0001 (2026-11-06): the clock knob (OracleClock.hpp).
+#include "OracleClock.hpp"
+
+#include "sketch_orca_oracle_clock.h"
+
+namespace Slic3r {
+namespace Oracle {
+
+bool clock_pinned()
+{
+    return sketch_orca_oracle_time(nullptr) == 1;
+}
+
+std::time_t pinned_time()
+{
+    long long seconds = 0;
+    sketch_orca_oracle_time(&seconds);
+    return std::time_t(seconds);
+}
+
+std::tm *oracle_localtime(const std::time_t &t, std::tm &out)
+{
+#ifdef _WIN32
+    if (clock_pinned())
+        return gmtime_s(&out, &t) == 0 ? &out : nullptr;
+    return localtime_s(&out, &t) == 0 ? &out : nullptr;
+#else
+    if (clock_pinned())
+        return gmtime_r(&t, &out);
+    return localtime_r(&t, &out);
+#endif
+}
+
+std::string clock_knob_problem()
+{
+    if (sketch_orca_oracle_time(nullptr) >= 0)
+        return std::string();
+    return "SKETCH_ORCA_ORACLE_TIME must be seconds since 1970-01-01 00:00:00 UTC, a whole number from 315532800 "
+           "(1980-01-01) to 4102444799 (2099-12-31 23:59:59), with nothing else in it";
+}
+
+} // namespace Oracle
+} // namespace Slic3r
