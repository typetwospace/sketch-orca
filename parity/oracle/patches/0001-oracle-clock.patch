diff --git a/deps_src/miniz/sketch_orca_oracle_clock.c b/deps_src/miniz/sketch_orca_oracle_clock.c
new file mode 100644
index 00000000..f902d7de
--- /dev/null
+++ b/deps_src/miniz/sketch_orca_oracle_clock.c
@@ -0,0 +1,59 @@
+// Copyright (C) 2026 The sketch-orca authors (see AUTHORS)
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// This file is part of sketch-orca, a modified version of OrcaSlicer. sketch-orca is free software:
+// you can redistribute it and/or modify it under the terms of the GNU Affero General Public
+// License, version 3, as published by the Free Software Foundation. It is distributed in the hope
+// that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License
+// (LICENSE) for more details.
+//
+// sketch-orca oracle patch 0001 (2026-11-06): the clock knob, SKETCH_ORCA_ORACLE_TIME
+// (sketch_orca_oracle_clock.h). The variable is read each time it is asked for; nothing reads it
+// unless a clock read asks.
+#include "sketch_orca_oracle_clock.h"
+
+#include <stdlib.h>
+#include <time.h>
+
+#define SKETCH_ORCA_ORACLE_TIME_MIN 315532800LL  /* 1980-01-01 00:00:00 UTC */
+#define SKETCH_ORCA_ORACLE_TIME_MAX 4102444799LL /* 2099-12-31 23:59:59 UTC */
+
+int sketch_orca_oracle_time(long long *seconds)
+{
+    const char *text = getenv("SKETCH_ORCA_ORACLE_TIME");
+    long long   value = 0;
+    int         digits = 0;
+    if (text == NULL)
+        return 0;
+    for (; *text != '\0'; ++text) {
+        if (*text < '0' || *text > '9' || ++digits > 10)
+            return -1;
+        value = value * 10 + (*text - '0');
+    }
+    if (digits == 0 || value < SKETCH_ORCA_ORACLE_TIME_MIN || value > SKETCH_ORCA_ORACLE_TIME_MAX)
+        return -1;
+    if (seconds != NULL)
+        *seconds = value;
+    return 1;
+}
+
+int sketch_orca_oracle_dos_time(unsigned short *dos_time, unsigned short *dos_date)
+{
+    long long seconds = 0;
+    time_t    t;
+    struct tm tm;
+    if (sketch_orca_oracle_time(&seconds) != 1)
+        return 0;
+    t = (time_t) seconds;
+#ifdef _MSC_VER
+    if (gmtime_s(&tm, &t) != 0)
+        return 0;
+#else
+    if (gmtime_r(&t, &tm) == NULL)
+        return 0;
+#endif
+    *dos_time = (unsigned short) (((tm.tm_hour) << 11) + ((tm.tm_min) << 5) + ((tm.tm_sec) >> 1));
+    *dos_date = (unsigned short) (((tm.tm_year + 1900 - 1980) << 9) + ((tm.tm_mon + 1) << 5) + tm.tm_mday);
+    return 1;
+}
