+// Copyright (C) 2026 The sketch-orca authors (see AUTHORS)
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// This file is part of sketch-orca, a modified version of OrcaSlicer. sketch-orca is free software:
+// you can redistribute it and/or modify it under the terms of the GNU Affero General Public
+// License, version 3, as published by the Free Software Foundation. It is distributed in the hope
+// that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of
+// MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU Affero General Public License
+// (LICENSE) for more details.
+//
+// sketch-orca oracle patch 0001 (2026-11-06): the clock knob of the parity oracle, a build of the
+// engine that never ships. SKETCH_ORCA_ORACLE_TIME, when set, is the time every clock read of the
+// oracle gives: seconds since 1970-01-01 00:00:00 UTC, a whole number from 315532800 (1980-01-01,
+// the first time a zip entry can hold) to 4102444799 (2099-12-31 23:59:59). With the knob set the
+// oracle's local time zone is UTC, so its output does not depend on the machine's.
+// Unset, nothing here changes what the engine does. It lives in miniz, the lowest library that
+// reads the clock, so that miniz and libslic3r (which links miniz) share one reading of it.
+#ifndef SKETCH_ORCA_ORACLE_CLOCK_H
+#define SKETCH_ORCA_ORACLE_CLOCK_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 1 when SKETCH_ORCA_ORACLE_TIME pins the clock (*seconds is then its value), 0 when it is not set,
+   -1 when it is set to something that is not a time in the range above. */
+int sketch_orca_oracle_time(long long *seconds);
+
+/* With the clock pinned: the pinned time as a zip entry's DOS time and date, in UTC, and 1.
+   Otherwise 0, and nothing is written. */
+int sketch_orca_oracle_dos_time(unsigned short *dos_time, unsigned short *dos_date);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
