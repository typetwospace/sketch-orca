+        dump.record("BRIM", brim_ears_record(*object, int64_t(i)));
+        for (size_t v = 0; v < object->volumes.size(); ++v)
+            dump.record("PNTV", painting_record(*object->volumes[v], int64_t(i), int64_t(v)));
     }
     dump.write();
