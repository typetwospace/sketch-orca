+// ---- The front end's model (sketch-orca oracle patch 0006, 2026-11-07) ----
+
+// PCGC: the plates' custom G-code (Model::plates_custom_gcodes) and the current plate.
+Payload plates_custom_gcodes_record(const Model &model)
+{
+    Payload p;
+    p.i32(int32_t(model.curr_plate_index));
+    p.count(model.plates_custom_gcodes.size());
+    for (const auto &plate : model.plates_custom_gcodes) {
+        p.i32(int32_t(plate.first));
+        p.i32(int32_t(plate.second.mode));
+        p.count(plate.second.gcodes.size());
+        for (const CustomGCode::Item &item : plate.second.gcodes) {
+            p.f64(item.print_z);
+            p.i32(int32_t(item.type));
+            p.i32(int32_t(item.extruder));
+            p.str(item.color);
+            p.str(item.extra);
+        }
+    }
+    return p;
+}
+
+// HRNG: an object's height ranges (ModelObject::layer_config_ranges), in the map's order.
+Payload height_ranges_record(const ModelObject &object, int64_t index)
+{
+    Payload p;
+    p.i64(index);
+    p.count(object.layer_config_ranges.size());
+    for (const auto &range : object.layer_config_ranges) {
+        p.f64(double(range.first.first));
+        p.f64(double(range.first.second));
+    }
+    return p;
+}
+
+// BRIM: an object's brim ears (ModelObject::brim_points).
+Payload brim_ears_record(const ModelObject &object, int64_t index)
+{
+    Payload p;
+    p.i64(index);
+    p.count(object.brim_points.size());
+    for (const BrimPoint &ear : object.brim_points) {
+        p.f32(ear.pos.x());
+        p.f32(ear.pos.y());
+        p.f32(ear.pos.z());
+        p.f32(ear.head_front_radius);
+    }
+    return p;
+}
+
+// One painting (TriangleSelector::TriangleSplittingData): the triangles to split with where their
+// bits start, the bitstream (its length, then its bits eight to a byte, the first in the lowest
+// bit) and the states used.
+void put_painting(Payload &p, const FacetsAnnotation &facets)
+{
+    const TriangleSelector::TriangleSplittingData &data = facets.get_data();
+    p.count(data.triangles_to_split.size());
+    for (const TriangleSelector::TriangleBitStreamMapping &m : data.triangles_to_split) {
+        p.i32(int32_t(m.triangle_idx));
+        p.i32(int32_t(m.bitstream_start_idx));
+    }
+    p.u64(uint64_t(data.bitstream.size()));
+    p.count((data.bitstream.size() + 7) / 8);
+    for (size_t at = 0; at < data.bitstream.size(); at += 8) {
+        uint8_t byte = 0;
+        for (size_t b = 0; b < 8 && at + b < data.bitstream.size(); ++b)
+            if (data.bitstream[at + b])
+                byte |= uint8_t(1u << b);
+        p.u8(byte);
+    }
+    p.count(data.used_states.size());
+    for (bool used : data.used_states)
+        p.boolean(used);
+}
+
+// PNTV: a volume's painting: supports, seams, colours (MMU segmentation), fuzzy skin.
+Payload painting_record(const ModelVolume &volume, int64_t object, int64_t index)
+{
+    Payload p;
+    p.i64(object);
+    p.i64(index);
+    put_painting(p, volume.supported_facets);
+    put_painting(p, volume.seam_facets);
+    put_painting(p, volume.mmu_segmentation_facets);
+    put_painting(p, volume.fuzzy_skin_facets);
+    return p;
+}
+
