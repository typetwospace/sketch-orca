sketch-orca patch 0001: build the dependencies without the GUI-only ones, and without IPP-ICV.
Modified for Sketch, 2026-10-30.

Adds the option DEP_WITH_GUI to deps/CMakeLists.txt. It defaults to ON, which keeps
upstream's behaviour. The pipeline sets it OFF: the `deps` target then leaves out wxWidgets
(and WebView2), GLFW, OpenCSG (and GLEW) and CURL, and adds libjpeg, which was only
built as a wxWidgets dependency but is needed by libslic3r.

Adds the option DEP_OPENCV_IPP, also ON by default. The pipeline sets it OFF, so OpenCV is
built with WITH_IPP=OFF on Windows as on every other platform: OpenCV's build no longer
downloads Intel's IPP-ICV (a binary package under Intel's licence, which Orca does not pin)
and links no IPP code.

---
diff --git a/deps/CMakeLists.txt b/deps/CMakeLists.txt
--- a/deps/CMakeLists.txt
+++ b/deps/CMakeLists.txt
@@ -55,6 +55,11 @@ endif ()
 
 set(DEP_DOWNLOAD_DIR ${CMAKE_CURRENT_SOURCE_DIR}/DL_CACHE CACHE PATH "Path for downloaded source packages.")
 set(FLATPAK FALSE CACHE BOOL "Toggles various build settings for flatpak, like /usr/local in DESTDIR or not building wxwidgets")
+# Sketch (sketch-orca), 2026-10-30: OFF builds only what libslic3r needs, without the GUI-only dependencies.
+option(DEP_WITH_GUI "Build the GUI-only dependencies (wxWidgets, GLFW, OpenCSG with GLEW, CURL)" ON)
+# Sketch (sketch-orca), 2026-10-30: OFF builds OpenCV without Intel's IPP-ICV, a binary package under
+# Intel's licence that OpenCV's own build downloads.
+option(DEP_OPENCV_IPP "Build OpenCV with Intel IPP-ICV on x64 Windows (downloaded by OpenCV's build)" ON)
 
 if ("${DESTDIR}" STREQUAL "" OR "${DESTDIR}" STREQUAL "${AUTOGENERATED_DESTDIR}")
     if (LINUX AND (NOT DEFINED USE_OLD_DESTDIR_PREV OR USE_OLD_DESTDIR_PREV) AND EXISTS "${CMAKE_BINARY_DIR}/destdir/usr/local" AND NOT EXISTS "${CMAKE_BINARY_DIR}/OrcaSlicer_dep/usr/local")
@@ -447,6 +452,13 @@ else()
     #list(APPEND _dep_list "dep_libigl")
 endif()
 
+if (NOT DEP_WITH_GUI)
+    # Sketch (sketch-orca), 2026-10-30: no wxWidgets (nor WebView2), GLFW, OpenCSG (nor GLEW) or CURL.
+    list(REMOVE_ITEM _dep_list dep_wxWidgets dep_GLFW dep_OpenCSG dep_CURL)
+    # libjpeg came in only as a wxWidgets dependency; libslic3r needs it too.
+    list(APPEND _dep_list ${JPEG_PKG})
+endif ()
+
 add_custom_target(deps ALL DEPENDS ${_dep_list})
 
 # Note: I'm not using any of the LOG_xxx options in ExternalProject_Add() commands
diff --git a/deps/OpenCV/OpenCV.cmake b/deps/OpenCV/OpenCV.cmake
--- a/deps/OpenCV/OpenCV.cmake
+++ b/deps/OpenCV/OpenCV.cmake
@@ -1,6 +1,7 @@
 # Intel IPP / IPP-ICV is x86/x64 only — there is no ARM64 build, so enabling it
 # leaves ~200 unresolved ippicv* externals at link time on Windows ARM64.
-if (MSVC AND NOT "${DEPS_ARCH}" STREQUAL "arm64")
+# Sketch (sketch-orca), 2026-10-30: and only with DEP_OPENCV_IPP (ON by default, as upstream).
+if (MSVC AND NOT "${DEPS_ARCH}" STREQUAL "arm64" AND DEP_OPENCV_IPP)
     set(_use_IPP "-DWITH_IPP=ON")
 else ()
     set(_use_IPP "-DWITH_IPP=OFF")
