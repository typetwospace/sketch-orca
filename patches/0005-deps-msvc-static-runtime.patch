sketch-orca patch 0005: build the dependencies with MSVC's static runtime library (/MT).
Modified for Sketch, 2026-11-01.

Adds the option DEP_MSVC_STATIC_RUNTIME to deps/CMakeLists.txt. It defaults to OFF, which keeps
upstream's behaviour (the dynamic runtime, /MD). The pipeline sets it ON on Windows: every CMake
dependency is then configured with CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded, and with policy
CMP0091 NEW, so that the projects whose cmake_minimum_required predates CMake 3.15 leave /MD out
of their default flags too. OpenCV picks its runtime itself; OpenCV.cmake passes it
BUILD_WITH_STATIC_CRT=ON with the option instead of the fixed OFF. With the engine built the
same way (CMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded, scripts/lib/cmake.ts), neither the engine
nor the libraries it loads (OpenCASCADE and FreeType are DLLs on Windows) imports a Visual C++
runtime DLL, and none is shipped. OpenSSL's static libraries are compiled with /Zl and name no
runtime, and the prebuilt GMP and MPFR load only Windows' own msvcrt.dll.

---
diff --git a/deps/CMakeLists.txt b/deps/CMakeLists.txt
--- a/deps/CMakeLists.txt
+++ b/deps/CMakeLists.txt
@@ -60,6 +60,9 @@ option(DEP_WITH_GUI "Build the GUI-only dependencies (wxWidgets, GLFW, OpenCSG w
 # Sketch (sketch-orca), 2026-10-30: OFF builds OpenCV without Intel's IPP-ICV, a binary package under
 # Intel's licence that OpenCV's own build downloads.
 option(DEP_OPENCV_IPP "Build OpenCV with Intel IPP-ICV on x64 Windows (downloaded by OpenCV's build)" ON)
+# Sketch (sketch-orca), 2026-11-01: ON builds every dependency with MSVC's static runtime library (/MT), so
+# that a program built on them loads no Visual C++ runtime DLL. OFF, the default, keeps upstream's /MD.
+option(DEP_MSVC_STATIC_RUNTIME "Build the dependencies with MSVC's static runtime library (/MT)" OFF)
 
 if ("${DESTDIR}" STREQUAL "" OR "${DESTDIR}" STREQUAL "${AUTOGENERATED_DESTDIR}")
     if (LINUX AND (NOT DEFINED USE_OLD_DESTDIR_PREV OR USE_OLD_DESTDIR_PREV) AND EXISTS "${CMAKE_BINARY_DIR}/destdir/usr/local" AND NOT EXISTS "${CMAKE_BINARY_DIR}/OrcaSlicer_dep/usr/local")
@@ -307,6 +310,14 @@ else()
     include("deps-linux.cmake")
 endif()
 
+# Sketch (sketch-orca), 2026-11-01: with DEP_MSVC_STATIC_RUNTIME, every CMake dependency takes the static
+# runtime. CMP0091 NEW keeps /MD out of the default flags of the projects whose cmake_minimum_required
+# predates CMake 3.15. OpenCV, which picks its runtime itself, follows the option in OpenCV.cmake; OpenSSL's
+# static libraries name no runtime (/Zl); the prebuilt GMP and MPFR load only the system's msvcrt.dll.
+if (MSVC AND DEP_MSVC_STATIC_RUNTIME)
+    list(APPEND DEP_CMAKE_OPTS -DCMAKE_POLICY_DEFAULT_CMP0091:STRING=NEW -DCMAKE_MSVC_RUNTIME_LIBRARY:STRING=MultiThreaded)
+endif ()
+
 if(FLATPAK)
     # flatpak bundles some deps with the layer, so attempt to find them first
     # also, yes, this reduces CI by not needing to vendor certain deps
diff --git a/deps/OpenCV/OpenCV.cmake b/deps/OpenCV/OpenCV.cmake
--- a/deps/OpenCV/OpenCV.cmake
+++ b/deps/OpenCV/OpenCV.cmake
@@ -7,6 +7,14 @@ else ()
     set(_use_IPP "-DWITH_IPP=OFF")
 endif ()
 
+# Sketch (sketch-orca), 2026-11-01: OpenCV picks its runtime library itself (BUILD_WITH_STATIC_CRT): /MT with
+# DEP_MSVC_STATIC_RUNTIME, like every other dependency then, else /MD as upstream.
+if (DEP_MSVC_STATIC_RUNTIME)
+    set(_static_crt ON)
+else ()
+    set(_static_crt OFF)
+endif ()
+
 if (IN_GIT_REPO)
     set(OpenCV_DIRECTORY_FLAG --directory ${BINARY_DIR_REL}/dep_OpenCV-prefix/src/dep_OpenCV)
 endif ()
@@ -71,7 +79,7 @@ orcaslicer_add_cmake_project(OpenCV
        -DWITH_OPENVINO=OFF
        -DWITH_INF_ENGINE=OFF
        -DWITH_NGRAPH=OFF
-       -DBUILD_WITH_STATIC_CRT=OFF#set /MDd /MD
+       -DBUILD_WITH_STATIC_CRT=${_static_crt} # Sketch (sketch-orca), 2026-11-01: was OFF (/MDd /MD); see above
        -DBUILD_LIST=core,imgcodecs,imgproc,world
        -DBUILD_opencv_highgui=OFF
        -DWITH_ADE=OFF
